<?xml version="1.0" encoding="utf-8"?>
<!-- 자주 가는 길과 기록은 이 기기 안에만 둔다. 클라우드 백업과 기기 간 이동에서 모두 뺀다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
